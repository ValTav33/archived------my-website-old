# ============================================================================
#  tavlikossystems.com — environment
#
#  Every variable below is validated in code, and every failure names the
#  variable. Two rules:
#
#    MISSING is not fatal (except NEXT_PUBLIC_SITE_URL). The site builds and
#    deploys with no secrets at all; the subsystem behind the missing value
#    turns itself off and says so.
#
#    MALFORMED is fatal. A present-but-wrong value stops the build instead of
#    surfacing three weeks later as a 500 on a submitted form. This is not
#    theoretical: a Vercel entry whose key existed and whose value was an
#    empty string once killed a production build on a bare
#    `TypeError: Invalid URL` that never mentioned the variable.
#
#  In Vercel, set these for **Production AND Preview**. A value set for
#  Production only means the preview deployment — the one place the form gets
#  exercised before it ships — behaves differently from the thing being
#  tested.
#
#  Nothing here except NEXT_PUBLIC_SITE_URL is NEXT_PUBLIC_. Do not add the
#  prefix to any of them: it is the only thing keeping a service-role key out
#  of the browser bundle.
# ============================================================================


# ─── REQUIRED ───────────────────────────────────────────────────────────────

# The build throws without it. There is no fallback on purpose: a default
# would let a misconfigured deploy point the canonical URL, the Open Graph
# tags and the JSON-LD @id at a domain we do not own, and nothing about the
# running site would look wrong.
#
# Must include the scheme and no trailing slash.
# Production:  https://tavlikossystems.com
# Local:       http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://tavlikossystems.com


# ─── MAIL — the delivery path (Phase 3, S3.3) ───────────────────────────────

# Resend API key. This is the launch gate: with no key, a submitted form
# returns 502 and tells the visitor to call instead. That is the honest
# failure and it is deliberate — there is no fallback that makes a missing
# transport look like a working one.
#
# Where: resend.com → API Keys → Create. Sending permission is enough.
RESEND_API_KEY=

# Optional. The envelope sender.
#
# Leave it EMPTY until the sending domain is verified: mail then goes out from
# Resend's sandbox address, which can only deliver to the Resend account
# holder's own address — which is the only recipient this phase has, so it
# works with no DNS records at all.
#
# Once tavlikossystems.com is verified in Resend (three DNS records), set this
# to something like:  Tavlikos Systems <info@tavlikossystems.com>
AUDIT_MAIL_FROM=


# ─── LEADS — the archive (Phase 3, S3.4 / S3.5) ─────────────────────────────

# Supabase project origin, https, no trailing slash.
# Where: Project Settings → API → Project URL.
#
# Create the project in eu-central-1 (Frankfurt). Leads are personal data from
# Greek businesses; keeping them in the EU keeps the /privacy processor
# section short and true.
SUPABASE_URL=

# The service_role key — NOT the publishable/anon one.
# Where: Project Settings → API Keys → service_role.
#
# Row-level security is enabled on both tables with zero policies, so the anon
# key can read nothing and write nothing. Pasting it here fails as silence:
# every submission would be delivered and archived nowhere. The code detects
# and rejects it rather than letting that happen.
SUPABASE_SERVICE_ROLE_KEY=

# Salt for the rate limiter's IP hash. REQUIRED as soon as SUPABASE_URL is
# set, and at least 32 characters.
#
# The limiter needs to recognise a repeat caller for one hour; it does not
# need to know who they are. An unsalted hash of an IPv4 address is
# reversible by brute force in seconds, which is a stored IP address with
# extra steps — so this is required rather than optional, and a missing value
# stops the build instead of quietly weakening what /privacy promises.
#
#   openssl rand -hex 32
AUDIT_IP_SALT=


# ─── CRON — retention and keepalive (Phase 3, S3.6) ─────────────────────────

# Bearer token Vercel sends on scheduled invocations of
# /api/cron/maintenance, which deletes expired rows.
#
# With no value set, that route refuses every request. It must never fail open
# — "the secret has not been set yet" is exactly when a public deletion
# endpoint would exist.
#
#   openssl rand -hex 32
CRON_SECRET=
