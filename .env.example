# REQUIRED — the build throws without it. There is no fallback on purpose:
# a default would let a misconfigured deploy point the canonical URL, the
# Open Graph tags and the JSON-LD @id at a domain we do not own.
#
# Must include the scheme and no trailing slash.
# Production:  https://tavlikossystems.com
# Local:       http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://tavlikossystems.com
